{
  "name": "sunday-church-golf",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint . --no-warn-ignored --ignore-pattern '.next*/**' --ignore-pattern '.netlify/**' --ignore-pattern '.worktrees/**' --ignore-pattern 'node_modules/**'",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/run-unit-tests.mjs",
    "check:state": "node scripts/build-discipline/state.mjs",
    "check:line-caps": "node scripts/build-discipline/line-caps.mjs",
    "check:release-config": "node scripts/build-discipline/release-config.mjs",
    "e2e": "playwright test",
    "verify:netlify": "node scripts/verify-release.mjs --netlify",
    "verify:release": "node scripts/verify-release.mjs",
    "verify:negative-probes": "node scripts/negative-probes.mjs",
    "deploy:production": "node scripts/deploy-production.mjs",
    "postinstall": "prisma generate",
    "db:migrate:dev": "prisma migrate dev",
    "db:migrate:prod": "prisma migrate deploy",
    "db:seed": "npx tsx prisma/seed.ts",
    "db:reset": "prisma migrate reset --force"
  },
  "dependencies": {
    "@prisma/client": "^6.2.0",
    "next": "^16.1.3",
    "react": "^19.2.3",
    "react-dom": "^19.2.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.16.0",
    "eslint-config-next": "15.1.0",
    "postcss": "^8.4.49",
    "prisma": "^6.2.0",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.0",
    "typescript": "5.9.3"
  }
}
